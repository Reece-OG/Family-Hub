# Copy this file to .env and adjust values.

# Database
POSTGRES_USER=familyhub
POSTGRES_PASSWORD=familyhub
POSTGRES_DB=familyhub

# Web app port on the host
WEB_PORT=3000

# Random long secret used to sign session JWTs. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=please-change-me-to-a-long-random-string

# Bootstrap parent account created on first boot (only if no users exist)
SEED_PARENT_EMAIL=parent@example.com
SEED_PARENT_PASSWORD=changeme
SEED_PARENT_NAME=Parent

# Branding — customise the app name shown in the nav, login, browser tab,
# PDF headers, and reminder emails. Leave blank to default to "Family Hub".
# Examples: ReeceHub, SimpsonHub, HomeBase.
APP_NAME=

# Docker container name prefix. Defaults to "family-hub" — containers will
# be named <prefix>-web and <prefix>-db. Change this if you run multiple
# instances side by side or want names to match APP_NAME.
# CONTAINER_PREFIX=family-hub
